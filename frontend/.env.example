# Copy to .env and adjust if your backend runs elsewhere.
#
# URL of the .NET backend (see backend/Properties/launchSettings.json).
# The frontend talks ONLY to this - never directly to the Python RAG service.
VITE_API_URL=http://localhost:5038

# Client-side upload-size hint / pre-check. Keep in step with MAX_UPLOAD_MB
# (Python) and Upload__MaxBytes (.NET). Default 200.
VITE_MAX_UPLOAD_MB=200
