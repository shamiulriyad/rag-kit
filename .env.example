# Copy to .env for `docker compose up`.
# (Running the services by hand instead? Each folder has its own .env.example -
#  this file is only read by docker-compose.yml.)

# ---- Required: Gemini API key (LLM + default embeddings) ----
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ---- Required for accounts / Knowledge Bases / chat history to persist ----
# Supabase dashboard -> Project Settings -> Database -> Connection string.
# Without this the backend still starts, but every DB-backed endpoint fails -
# see the warning it logs. Any Postgres connection string works, Supabase or not.
DATABASE_CONNECTION_STRING=Host=YOUR-PROJECT.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=YOUR_DB_PASSWORD

# ---- Required for real sessions across restarts (a random one is used otherwise) ----
# Generate with `openssl rand -base64 48` (or similar) - at least 32 characters.
JWT_SECRET=

# ---- Optional: Supabase Storage for uploaded PDFs ----
# Leave blank to store uploaded PDFs on local disk instead (fine for local trials -
# see backend/Integrations/Supabase/LocalDiskStorageService.cs).
# Supabase dashboard -> Project Settings -> API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Optional overrides (sensible defaults shown) ----
# Embedding model. Default needs no extra setup. The local options need the rag
# image rebuilt with requirements-local.txt (see rag/Dockerfile).
#   google      / gemini-embedding-001                    (default, 3072-dim)
#   huggingface / sentence-transformers/all-MiniLM-L6-v2  (local, English, 384-dim)
#   huggingface / BAAI/bge-m3                             (local, multilingual, 1024-dim)
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001

LLM_MODEL=gemini-2.5-flash

# ---- Step 4: chunking (per-Knowledge-Base defaults; overridable via /api/settings) ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Step 9: retrieval ----
TOP_K=4

# ---- Uploads ----
# Applied on both hops: browser -> .NET (UPLOAD_MAX_BYTES) and .NET -> Python (MAX_UPLOAD_MB).
MAX_UPLOAD_MB=200
UPLOAD_MAX_BYTES=209715200
