# Copy to .env for `docker compose up`. Only GOOGLE_API_KEY is required.
# (Running the services by hand instead? Each folder has its own .env.example -
#  this file is only read by docker-compose.yml.)

# ---- Required: Gemini API key (LLM + default embeddings) ----
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ---- Optional overrides (sensible defaults shown) ----
# Embedding model. Default needs no extra setup. The local options need the rag
# image rebuilt with requirements-local.txt (see rag/Dockerfile).
#   google      / gemini-embedding-001                    (default, 3072-dim)
#   huggingface / sentence-transformers/all-MiniLM-L6-v2  (local, English, 384-dim)
#   huggingface / BAAI/bge-m3                             (local, multilingual, 1024-dim)
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001

COLLECTION_NAME=pdf_rag
LLM_MODEL=gemini-2.5-flash

# ---- Step 4: chunking (read by the rag service) ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Step 9: retrieval ----
TOP_K=4

# ---- Upload limits (UI PDF upload) ----
# Applied on both hops: browser -> .NET (Upload__MaxBytes) and .NET -> Python
# (MAX_UPLOAD_MB). Not unlimited - raise deliberately for very large PDFs.
MAX_UPLOAD_MB=200
MIN_TEXT_CHARS=200
