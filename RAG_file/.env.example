# Copy this file to .env and fill in your key.
# Relative paths (PDF_PATH, QDRANT_PATH) are resolved against the project folder,
# so the commands work from any directory.

# ---- Gemini (used for the LLM in step 10, and for embeddings if you pick it) ----
# Get a key: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# ---- Step 1: which PDF to ingest ----
PDF_PATH=data/sample.pdf

# ---- Step 4: chunking ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ---- Step 5: embeddings ----
# huggingface = local model, no API key, no quota (first run downloads the model).
# google      = Gemini embeddings, needs a key with embedding quota.
EMBEDDING_PROVIDER=huggingface
# Light + fast, English:            sentence-transformers/all-MiniLM-L6-v2
# Multilingual incl. Bangla (big):  BAAI/bge-m3
# Gemini (set EMBEDDING_PROVIDER=google): models/gemini-embedding-001
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave empty to auto-detect the real vector size (recommended).
EMBEDDING_DIM=

# ---- Step 6: Qdrant ----
# Default: embedded on-disk, no server needed. QDRANT_URL is ignored when this is set.
QDRANT_PATH=qdrant_data
# To use a Qdrant server instead, clear QDRANT_PATH and set:
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=pdf_rag

# ---- Step 9: retrieval ----
TOP_K=4

# ---- Step 10: Gemini LLM ----
LLM_MODEL=gemini-2.5-flash
TEMPERATURE=0.2
