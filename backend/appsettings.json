{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": ""
  },

  "Jwt": {
    "Secret": "",
    "Issuer": "rag-starter",
    "Audience": "rag-starter-client",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 30
  },

  "Supabase": {
    "Url": "",
    "AnonKey": "",
    "ServiceRoleKey": "",
    "StorageBucket": "documents"
  },

  "Storage": {
    "LocalRoot": "storage_data"
  },

  "Rag": {
    "BaseUrl": "http://localhost:8000",
    "TimeoutSeconds": 600
  },

  "Upload": {
    "MaxBytes": 209715200
  },

  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },

  "IpRateLimiting": {
    "EnableEndpointRateLimiting": false,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      { "Endpoint": "*", "Period": "1m", "Limit": 120 },
      { "Endpoint": "post:/api/auth/*", "Period": "1m", "Limit": 20 }
    ]
  }
}
