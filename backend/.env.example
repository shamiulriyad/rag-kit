# The .NET backend reads its settings from appsettings.json / appsettings.Development.json.
# There is no .env loader in .NET - export these in your shell/process manager, or put
# them in docker-compose's env_file. Any setting can be overridden by an environment
# variable using "__" (double underscore) as the section separator.

# ---- Database (Supabase Postgres in production; any Postgres works for local dev) ----
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI or .NET style).
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=ragstarter;Username=postgres;Password=postgres

# ---- Supabase (app metadata lives in Postgres above; these are for Storage + admin APIs) ----
# Leave these three blank for local dev - uploaded PDFs then fall back to local disk
# storage (Integrations/Supabase/LocalDiskStorageService). Set them to use real Supabase Storage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
Supabase__StorageBucket=documents

# ---- JWT ----
# Generate a long random value, e.g. `openssl rand -base64 48`. Never reuse the dev default.
Jwt__Secret=change-me-to-a-long-random-value
Jwt__Issuer=rag-starter
Jwt__Audience=rag-starter-client
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=30

# ---- Python RAG service ----
Rag__BaseUrl=http://localhost:8000
Rag__TimeoutSeconds=600

# ---- Uploads ----
# Max PDF upload size in bytes (default 200 MB). Keep in step with MAX_UPLOAD_MB on the
# Python side. Enforced by Kestrel + FormOptions; not unlimited.
Upload__MaxBytes=209715200

# ---- CORS ----
Cors__Origins__0=http://localhost:5173

# Port this API listens on (otherwise taken from Properties/launchSettings.json).
ASPNETCORE_URLS=http://localhost:5038
