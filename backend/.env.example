# The .NET backend reads its settings from appsettings.json. You do NOT need a
# .env file to run it - this is only here to show the overrides available.
#
# Any setting can be overridden by an environment variable, using "__" (double
# underscore) as the section separator. No .env loader is involved; export these
# in your shell (or your process manager) if the defaults don't fit.

# Base URL of the Python RAG service (rag/main.py, run with `uvicorn main:app --port 8000`)
Rag__BaseUrl=http://localhost:8000

# Seconds to wait for Python. Embedding a large PDF on the free Gemini tier is slow.
Rag__TimeoutSeconds=600

# Max PDF upload size in bytes (default 200 MB). Keep it in step with MAX_UPLOAD_MB
# on the Python side. Enforced by Kestrel + FormOptions; not unlimited.
Upload__MaxBytes=209715200

# Origin of the React dev server, for CORS (Vite's default is 5173).
Cors__Origins__0=http://localhost:5173

# Port this API listens on (otherwise taken from Properties/launchSettings.json).
ASPNETCORE_URLS=http://localhost:5038
